        <mxCell id="5b4KAu9YO9neWqidSYG_-24" parent="1" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=7;rounded=0;strokeWidth=1.5;" value="&lt;b&gt;XỬ LÝ MỘT BƯỚC TRELLIS&lt;/b&gt;&lt;br&gt;1. Lấy rx_pair từ frame_reg theo fwd_step&lt;br&gt;2. Tính branch metric (BM) cho 4 nhánh&lt;br&gt;3. Chạy 4 khối ACS song song&lt;br&gt;4. Cập nhật 4 Path Metric (bão hòa ở 31)&lt;br&gt;5. Lưu decision_vec vào survivor_mem[fwd_step][3:0]" vertex="1">
          <mxGeometry height="150" width="540" x="314" y="-157" as="geometry" />
        </mxCell>
