          <mxGeometry height="65" width="430" x="500" y="125" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;fillColor=#DDEBF7;strokeColor=#6C9BC2;fontSize=19;" value="&lt;b&gt;SELECT — tại cạnh lên clk&lt;/b&gt;&lt;br&gt;Chọn tb_state có PM cuối nhỏ nhất&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tb_step ← 7&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;decoded_work ← 0&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Chuyển sang TRACEBACK" vertex="1">
          <mxGeometry height="145" width="470" x="480" y="230" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;fillColor=#FFF2CC;strokeColor=#CBAA51;fontSize=18;" value="&lt;b&gt;TRACEBACK — đọc tổ hợp&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;survivor_word = decision_mem[tb_step]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;decision = survivor_word[tb_state]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Bit giải mã = &lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tb_state[1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;State cha = &lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;{tb_state[0], decision}&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="470" x="480" y="420" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;rhombus;fillColor=#FFF2CC;strokeColor=#CBAA51;fontSize=21;spacing=0;" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tb_step == 0 ?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="320" x="555" y="620" as="geometry" />
        </mxCell>
        <mxCell id="t8" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;fillColor=#E4DFEC;strokeColor=#9673A6;fontSize=18;" value="&lt;b&gt;Tại cạnh lên clk — lưu bit, lùi bước&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;decoded_work[7 − tb_step] ← bit giải mã&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tb_state ← state cha&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tb_step ← tb_step − 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Giữ trạng thái TRACEBACK" vertex="1">
          <mxGeometry height="170" width="400" x="30" y="610" as="geometry" />
        </mxCell>
        <mxCell id="t9" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;fillColor=#E2F0D9;strokeColor=#82A864;fontSize=19;" value="&lt;b&gt;Tại cạnh lên clk — lưu bit cuối&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;decoded_work[7] ← bit giải mã&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tb_state ← state cha&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Giữ tb_step = 0; chuyển sang DONE" vertex="1">
          <mxGeometry height="150" width="430" x="1040" y="610" as="geometry" />
        </mxCell>
        <mxCell id="t10" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;fillColor=#DDEBF7;strokeColor=#6C9BC2;fontSize=19;" value="&lt;b&gt;DONE — tại cạnh lên clk tiếp theo&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;data_out ← decoded_work&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;done ← 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Chuyển về IDLE" vertex="1">
