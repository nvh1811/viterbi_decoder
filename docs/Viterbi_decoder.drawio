        <mxCell id="t2" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;strokeColor=none;fillColor=none;fontSize=29;fontStyle=1;" value="LƯU ĐỒ TRACEBACK VÀ XUẤT DỮ LIỆU GIẢI MÃ" vertex="1">
          <mxGeometry height="50" width="1480" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="whiteSpace=wrap;html=1;rounded=0;strokeColor=#70879B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontColor=#17334B;spacing=8;strokeColor=none;fillColor=none;fontSize=20;fontColor=#60778D;" value="Một khung 8 bước trellis • chọn trạng thái cuối, truy vết và trả kết quả" vertex="1">
